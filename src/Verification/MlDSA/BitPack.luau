--[=[
	BitPack: ML-DSA polynomial vectors packed at a fixed bit width (FIPS 204 SimpleBitPack and
	BitPack). Coefficients are u32 in [0, q). The centered forms store X - c, so a coefficient in
	[X - 2^Bits + 1, X] round trips; t1 decodes already multiplied by 2^13

	Example usage:
		BitPack.EncodeCentered(S1, 0, L * 256, Eta, 3, SecretKey, 128)
		BitPack.DecodeT1(PublicKey, 32, K * 256, T1, 0)
--]=]

--!strict
--!optimize 2
--!native

local Q = 8380417

local function EncodeT1(Vector: buffer, VectorOffset: number, Coefficients: number, Output: buffer, OutputOffset: number)
	for Group = 0, Coefficients / 16 - 1 do
		local In = VectorOffset + Group * 64
		local Out = OutputOffset + Group * 20
		local C0 = buffer.readu32(Vector, In)
		local C1 = buffer.readu32(Vector, In + 4)
		local C2 = buffer.readu32(Vector, In + 8)
		local C3 = buffer.readu32(Vector, In + 12)
		buffer.writeu32(Output, Out, bit32.bor(C0, bit32.lshift(C1, 10), bit32.lshift(C2, 20), bit32.lshift(C3, 30)))
		local C4 = buffer.readu32(Vector, In + 16)
		local C5 = buffer.readu32(Vector, In + 20)
		local C6 = buffer.readu32(Vector, In + 24)
		buffer.writeu32(Output, Out + 4, bit32.bor(bit32.rshift(C3, 2), bit32.lshift(C4, 8), bit32.lshift(C5, 18), bit32.lshift(C6, 28)))
		local C7 = buffer.readu32(Vector, In + 28)
		local C8 = buffer.readu32(Vector, In + 32)
		local C9 = buffer.readu32(Vector, In + 36)
		buffer.writeu32(Output, Out + 8, bit32.bor(bit32.rshift(C6, 4), bit32.lshift(C7, 6), bit32.lshift(C8, 16), bit32.lshift(C9, 26)))
		local C10 = buffer.readu32(Vector, In + 40)
		local C11 = buffer.readu32(Vector, In + 44)
		local C12 = buffer.readu32(Vector, In + 48)
		buffer.writeu32(Output, Out + 12, bit32.bor(bit32.rshift(C9, 6), bit32.lshift(C10, 4), bit32.lshift(C11, 14), bit32.lshift(C12, 24)))
		local C13 = buffer.readu32(Vector, In + 52)
		local C14 = buffer.readu32(Vector, In + 56)
		local C15 = buffer.readu32(Vector, In + 60)
		buffer.writeu32(Output, Out + 16, bit32.bor(bit32.rshift(C12, 8), bit32.lshift(C13, 2), bit32.lshift(C14, 12), bit32.lshift(C15, 22)))
	end
end

local function DecodeT1(Data: buffer, DataOffset: number, Coefficients: number, Vector: buffer, VectorOffset: number)
	for Group = 0, Coefficients / 16 - 1 do
		local In = DataOffset + Group * 20
		local Out = VectorOffset + Group * 64
		local W0 = buffer.readu32(Data, In)
		buffer.writeu32(Vector, Out, bit32.lshift(bit32.band(W0, 1023), 13))
		buffer.writeu32(Vector, Out + 4, bit32.lshift(bit32.band(bit32.rshift(W0, 10), 1023), 13))
		buffer.writeu32(Vector, Out + 8, bit32.lshift(bit32.band(bit32.rshift(W0, 20), 1023), 13))
		local W1 = buffer.readu32(Data, In + 4)
		buffer.writeu32(Vector, Out + 12, bit32.lshift(bit32.band(bit32.bor(bit32.rshift(W0, 30), bit32.lshift(W1, 2)), 1023), 13))
		buffer.writeu32(Vector, Out + 16, bit32.lshift(bit32.band(bit32.rshift(W1, 8), 1023), 13))
		buffer.writeu32(Vector, Out + 20, bit32.lshift(bit32.band(bit32.rshift(W1, 18), 1023), 13))
		local W2 = buffer.readu32(Data, In + 8)
		buffer.writeu32(Vector, Out + 24, bit32.lshift(bit32.band(bit32.bor(bit32.rshift(W1, 28), bit32.lshift(W2, 4)), 1023), 13))
		buffer.writeu32(Vector, Out + 28, bit32.lshift(bit32.band(bit32.rshift(W2, 6), 1023), 13))
		buffer.writeu32(Vector, Out + 32, bit32.lshift(bit32.band(bit32.rshift(W2, 16), 1023), 13))
		local W3 = buffer.readu32(Data, In + 12)
		buffer.writeu32(Vector, Out + 36, bit32.lshift(bit32.band(bit32.bor(bit32.rshift(W2, 26), bit32.lshift(W3, 6)), 1023), 13))
		buffer.writeu32(Vector, Out + 40, bit32.lshift(bit32.band(bit32.rshift(W3, 4), 1023), 13))
		buffer.writeu32(Vector, Out + 44, bit32.lshift(bit32.band(bit32.rshift(W3, 14), 1023), 13))
		local W4 = buffer.readu32(Data, In + 16)
		buffer.writeu32(Vector, Out + 48, bit32.lshift(bit32.band(bit32.bor(bit32.rshift(W3, 24), bit32.lshift(W4, 8)), 1023), 13))
		buffer.writeu32(Vector, Out + 52, bit32.lshift(bit32.band(bit32.rshift(W4, 2), 1023), 13))
		buffer.writeu32(Vector, Out + 56, bit32.lshift(bit32.band(bit32.rshift(W4, 12), 1023), 13))
		buffer.writeu32(Vector, Out + 60, bit32.lshift(bit32.rshift(W4, 22), 13))
	end
end

local function EncodeCentered3(Vector: buffer, VectorOffset: number, Coefficients: number, X: number, Output: buffer, OutputOffset: number)
	for Group = 0, Coefficients / 32 - 1 do
		local In = VectorOffset + Group * 128
		local Out = OutputOffset + Group * 12
		local D0 = X - buffer.readu32(Vector, In)
		local C0 = D0 + bit32.band(Q, bit32.arshift(D0, 31))
		local D1 = X - buffer.readu32(Vector, In + 4)
		local C1 = D1 + bit32.band(Q, bit32.arshift(D1, 31))
		local D2 = X - buffer.readu32(Vector, In + 8)
		local C2 = D2 + bit32.band(Q, bit32.arshift(D2, 31))
		local D3 = X - buffer.readu32(Vector, In + 12)
		local C3 = D3 + bit32.band(Q, bit32.arshift(D3, 31))
		local D4 = X - buffer.readu32(Vector, In + 16)
		local C4 = D4 + bit32.band(Q, bit32.arshift(D4, 31))
		local D5 = X - buffer.readu32(Vector, In + 20)
		local C5 = D5 + bit32.band(Q, bit32.arshift(D5, 31))
		local D6 = X - buffer.readu32(Vector, In + 24)
		local C6 = D6 + bit32.band(Q, bit32.arshift(D6, 31))
		local D7 = X - buffer.readu32(Vector, In + 28)
		local C7 = D7 + bit32.band(Q, bit32.arshift(D7, 31))
		local D8 = X - buffer.readu32(Vector, In + 32)
		local C8 = D8 + bit32.band(Q, bit32.arshift(D8, 31))
		local D9 = X - buffer.readu32(Vector, In + 36)
		local C9 = D9 + bit32.band(Q, bit32.arshift(D9, 31))
		local D10 = X - buffer.readu32(Vector, In + 40)
		local C10 = D10 + bit32.band(Q, bit32.arshift(D10, 31))
		buffer.writeu32(Output, Out, bit32.bor(C0, bit32.lshift(C1, 3), bit32.lshift(C2, 6), bit32.lshift(C3, 9), bit32.bor(bit32.lshift(C4, 12), bit32.lshift(C5, 15), bit32.lshift(C6, 18), bit32.lshift(C7, 21), bit32.bor(bit32.lshift(C8, 24), bit32.lshift(C9, 27), bit32.lshift(C10, 30)))))
		local D11 = X - buffer.readu32(Vector, In + 44)
		local C11 = D11 + bit32.band(Q, bit32.arshift(D11, 31))
		local D12 = X - buffer.readu32(Vector, In + 48)
		local C12 = D12 + bit32.band(Q, bit32.arshift(D12, 31))
		local D13 = X - buffer.readu32(Vector, In + 52)
		local C13 = D13 + bit32.band(Q, bit32.arshift(D13, 31))
		local D14 = X - buffer.readu32(Vector, In + 56)
		local C14 = D14 + bit32.band(Q, bit32.arshift(D14, 31))
		local D15 = X - buffer.readu32(Vector, In + 60)
		local C15 = D15 + bit32.band(Q, bit32.arshift(D15, 31))
		local D16 = X - buffer.readu32(Vector, In + 64)
		local C16 = D16 + bit32.band(Q, bit32.arshift(D16, 31))
		local D17 = X - buffer.readu32(Vector, In + 68)
		local C17 = D17 + bit32.band(Q, bit32.arshift(D17, 31))
		local D18 = X - buffer.readu32(Vector, In + 72)
		local C18 = D18 + bit32.band(Q, bit32.arshift(D18, 31))
		local D19 = X - buffer.readu32(Vector, In + 76)
		local C19 = D19 + bit32.band(Q, bit32.arshift(D19, 31))
		local D20 = X - buffer.readu32(Vector, In + 80)
		local C20 = D20 + bit32.band(Q, bit32.arshift(D20, 31))
		local D21 = X - buffer.readu32(Vector, In + 84)
		local C21 = D21 + bit32.band(Q, bit32.arshift(D21, 31))
		buffer.writeu32(Output, Out + 4, bit32.bor(bit32.rshift(C10, 2), bit32.lshift(C11, 1), bit32.lshift(C12, 4), bit32.lshift(C13, 7), bit32.bor(bit32.lshift(C14, 10), bit32.lshift(C15, 13), bit32.lshift(C16, 16), bit32.lshift(C17, 19), bit32.bor(bit32.lshift(C18, 22), bit32.lshift(C19, 25), bit32.lshift(C20, 28), bit32.lshift(C21, 31)))))
		local D22 = X - buffer.readu32(Vector, In + 88)
		local C22 = D22 + bit32.band(Q, bit32.arshift(D22, 31))
		local D23 = X - buffer.readu32(Vector, In + 92)
		local C23 = D23 + bit32.band(Q, bit32.arshift(D23, 31))
		local D24 = X - buffer.readu32(Vector, In + 96)
		local C24 = D24 + bit32.band(Q, bit32.arshift(D24, 31))
		local D25 = X - buffer.readu32(Vector, In + 100)
		local C25 = D25 + bit32.band(Q, bit32.arshift(D25, 31))
		local D26 = X - buffer.readu32(Vector, In + 104)
		local C26 = D26 + bit32.band(Q, bit32.arshift(D26, 31))
		local D27 = X - buffer.readu32(Vector, In + 108)
		local C27 = D27 + bit32.band(Q, bit32.arshift(D27, 31))
		local D28 = X - buffer.readu32(Vector, In + 112)
		local C28 = D28 + bit32.band(Q, bit32.arshift(D28, 31))
		local D29 = X - buffer.readu32(Vector, In + 116)
		local C29 = D29 + bit32.band(Q, bit32.arshift(D29, 31))
		local D30 = X - buffer.readu32(Vector, In + 120)
		local C30 = D30 + bit32.band(Q, bit32.arshift(D30, 31))
		local D31 = X - buffer.readu32(Vector, In + 124)
		local C31 = D31 + bit32.band(Q, bit32.arshift(D31, 31))
		buffer.writeu32(Output, Out + 8, bit32.bor(bit32.rshift(C21, 1), bit32.lshift(C22, 2), bit32.lshift(C23, 5), bit32.lshift(C24, 8), bit32.bor(bit32.lshift(C25, 11), bit32.lshift(C26, 14), bit32.lshift(C27, 17), bit32.lshift(C28, 20), bit32.bor(bit32.lshift(C29, 23), bit32.lshift(C30, 26), bit32.lshift(C31, 29)))))
	end
end

local function DecodeCentered3(Data: buffer, DataOffset: number, Coefficients: number, X: number, Vector: buffer, VectorOffset: number)
	for Group = 0, Coefficients / 32 - 1 do
		local In = DataOffset + Group * 12
		local Out = VectorOffset + Group * 128
		local W0 = buffer.readu32(Data, In)
		local D0 = X - bit32.band(W0, 7)
		buffer.writeu32(Vector, Out, D0 + bit32.band(Q, bit32.arshift(D0, 31)))
		local D1 = X - bit32.band(bit32.rshift(W0, 3), 7)
		buffer.writeu32(Vector, Out + 4, D1 + bit32.band(Q, bit32.arshift(D1, 31)))
		local D2 = X - bit32.band(bit32.rshift(W0, 6), 7)
		buffer.writeu32(Vector, Out + 8, D2 + bit32.band(Q, bit32.arshift(D2, 31)))
		local D3 = X - bit32.band(bit32.rshift(W0, 9), 7)
		buffer.writeu32(Vector, Out + 12, D3 + bit32.band(Q, bit32.arshift(D3, 31)))
		local D4 = X - bit32.band(bit32.rshift(W0, 12), 7)
		buffer.writeu32(Vector, Out + 16, D4 + bit32.band(Q, bit32.arshift(D4, 31)))
		local D5 = X - bit32.band(bit32.rshift(W0, 15), 7)
		buffer.writeu32(Vector, Out + 20, D5 + bit32.band(Q, bit32.arshift(D5, 31)))
		local D6 = X - bit32.band(bit32.rshift(W0, 18), 7)
		buffer.writeu32(Vector, Out + 24, D6 + bit32.band(Q, bit32.arshift(D6, 31)))
		local D7 = X - bit32.band(bit32.rshift(W0, 21), 7)
		buffer.writeu32(Vector, Out + 28, D7 + bit32.band(Q, bit32.arshift(D7, 31)))
		local D8 = X - bit32.band(bit32.rshift(W0, 24), 7)
		buffer.writeu32(Vector, Out + 32, D8 + bit32.band(Q, bit32.arshift(D8, 31)))
		local D9 = X - bit32.band(bit32.rshift(W0, 27), 7)
		buffer.writeu32(Vector, Out + 36, D9 + bit32.band(Q, bit32.arshift(D9, 31)))
		local W1 = buffer.readu32(Data, In + 4)
		local D10 = X - bit32.band(bit32.bor(bit32.rshift(W0, 30), bit32.lshift(W1, 2)), 7)
		buffer.writeu32(Vector, Out + 40, D10 + bit32.band(Q, bit32.arshift(D10, 31)))
		local D11 = X - bit32.band(bit32.rshift(W1, 1), 7)
		buffer.writeu32(Vector, Out + 44, D11 + bit32.band(Q, bit32.arshift(D11, 31)))
		local D12 = X - bit32.band(bit32.rshift(W1, 4), 7)
		buffer.writeu32(Vector, Out + 48, D12 + bit32.band(Q, bit32.arshift(D12, 31)))
		local D13 = X - bit32.band(bit32.rshift(W1, 7), 7)
		buffer.writeu32(Vector, Out + 52, D13 + bit32.band(Q, bit32.arshift(D13, 31)))
		local D14 = X - bit32.band(bit32.rshift(W1, 10), 7)
		buffer.writeu32(Vector, Out + 56, D14 + bit32.band(Q, bit32.arshift(D14, 31)))
		local D15 = X - bit32.band(bit32.rshift(W1, 13), 7)
		buffer.writeu32(Vector, Out + 60, D15 + bit32.band(Q, bit32.arshift(D15, 31)))
		local D16 = X - bit32.band(bit32.rshift(W1, 16), 7)
		buffer.writeu32(Vector, Out + 64, D16 + bit32.band(Q, bit32.arshift(D16, 31)))
		local D17 = X - bit32.band(bit32.rshift(W1, 19), 7)
		buffer.writeu32(Vector, Out + 68, D17 + bit32.band(Q, bit32.arshift(D17, 31)))
		local D18 = X - bit32.band(bit32.rshift(W1, 22), 7)
		buffer.writeu32(Vector, Out + 72, D18 + bit32.band(Q, bit32.arshift(D18, 31)))
		local D19 = X - bit32.band(bit32.rshift(W1, 25), 7)
		buffer.writeu32(Vector, Out + 76, D19 + bit32.band(Q, bit32.arshift(D19, 31)))
		local D20 = X - bit32.band(bit32.rshift(W1, 28), 7)
		buffer.writeu32(Vector, Out + 80, D20 + bit32.band(Q, bit32.arshift(D20, 31)))
		local W2 = buffer.readu32(Data, In + 8)
		local D21 = X - bit32.band(bit32.bor(bit32.rshift(W1, 31), bit32.lshift(W2, 1)), 7)
		buffer.writeu32(Vector, Out + 84, D21 + bit32.band(Q, bit32.arshift(D21, 31)))
		local D22 = X - bit32.band(bit32.rshift(W2, 2), 7)
		buffer.writeu32(Vector, Out + 88, D22 + bit32.band(Q, bit32.arshift(D22, 31)))
		local D23 = X - bit32.band(bit32.rshift(W2, 5), 7)
		buffer.writeu32(Vector, Out + 92, D23 + bit32.band(Q, bit32.arshift(D23, 31)))
		local D24 = X - bit32.band(bit32.rshift(W2, 8), 7)
		buffer.writeu32(Vector, Out + 96, D24 + bit32.band(Q, bit32.arshift(D24, 31)))
		local D25 = X - bit32.band(bit32.rshift(W2, 11), 7)
		buffer.writeu32(Vector, Out + 100, D25 + bit32.band(Q, bit32.arshift(D25, 31)))
		local D26 = X - bit32.band(bit32.rshift(W2, 14), 7)
		buffer.writeu32(Vector, Out + 104, D26 + bit32.band(Q, bit32.arshift(D26, 31)))
		local D27 = X - bit32.band(bit32.rshift(W2, 17), 7)
		buffer.writeu32(Vector, Out + 108, D27 + bit32.band(Q, bit32.arshift(D27, 31)))
		local D28 = X - bit32.band(bit32.rshift(W2, 20), 7)
		buffer.writeu32(Vector, Out + 112, D28 + bit32.band(Q, bit32.arshift(D28, 31)))
		local D29 = X - bit32.band(bit32.rshift(W2, 23), 7)
		buffer.writeu32(Vector, Out + 116, D29 + bit32.band(Q, bit32.arshift(D29, 31)))
		local D30 = X - bit32.band(bit32.rshift(W2, 26), 7)
		buffer.writeu32(Vector, Out + 120, D30 + bit32.band(Q, bit32.arshift(D30, 31)))
		local D31 = X - bit32.rshift(W2, 29)
		buffer.writeu32(Vector, Out + 124, D31 + bit32.band(Q, bit32.arshift(D31, 31)))
	end
end

local function EncodeCentered4(Vector: buffer, VectorOffset: number, Coefficients: number, X: number, Output: buffer, OutputOffset: number)
	for Group = 0, Coefficients / 8 - 1 do
		local In = VectorOffset + Group * 32
		local Out = OutputOffset + Group * 4
		local D0 = X - buffer.readu32(Vector, In)
		local C0 = D0 + bit32.band(Q, bit32.arshift(D0, 31))
		local D1 = X - buffer.readu32(Vector, In + 4)
		local C1 = D1 + bit32.band(Q, bit32.arshift(D1, 31))
		local D2 = X - buffer.readu32(Vector, In + 8)
		local C2 = D2 + bit32.band(Q, bit32.arshift(D2, 31))
		local D3 = X - buffer.readu32(Vector, In + 12)
		local C3 = D3 + bit32.band(Q, bit32.arshift(D3, 31))
		local D4 = X - buffer.readu32(Vector, In + 16)
		local C4 = D4 + bit32.band(Q, bit32.arshift(D4, 31))
		local D5 = X - buffer.readu32(Vector, In + 20)
		local C5 = D5 + bit32.band(Q, bit32.arshift(D5, 31))
		local D6 = X - buffer.readu32(Vector, In + 24)
		local C6 = D6 + bit32.band(Q, bit32.arshift(D6, 31))
		local D7 = X - buffer.readu32(Vector, In + 28)
		local C7 = D7 + bit32.band(Q, bit32.arshift(D7, 31))
		buffer.writeu32(Output, Out, bit32.bor(C0, bit32.lshift(C1, 4), bit32.lshift(C2, 8), bit32.lshift(C3, 12), bit32.bor(bit32.lshift(C4, 16), bit32.lshift(C5, 20), bit32.lshift(C6, 24), bit32.lshift(C7, 28))))
	end
end

local function DecodeCentered4(Data: buffer, DataOffset: number, Coefficients: number, X: number, Vector: buffer, VectorOffset: number)
	for Group = 0, Coefficients / 8 - 1 do
		local In = DataOffset + Group * 4
		local Out = VectorOffset + Group * 32
		local W0 = buffer.readu32(Data, In)
		local D0 = X - bit32.band(W0, 15)
		buffer.writeu32(Vector, Out, D0 + bit32.band(Q, bit32.arshift(D0, 31)))
		local D1 = X - bit32.band(bit32.rshift(W0, 4), 15)
		buffer.writeu32(Vector, Out + 4, D1 + bit32.band(Q, bit32.arshift(D1, 31)))
		local D2 = X - bit32.band(bit32.rshift(W0, 8), 15)
		buffer.writeu32(Vector, Out + 8, D2 + bit32.band(Q, bit32.arshift(D2, 31)))
		local D3 = X - bit32.band(bit32.rshift(W0, 12), 15)
		buffer.writeu32(Vector, Out + 12, D3 + bit32.band(Q, bit32.arshift(D3, 31)))
		local D4 = X - bit32.band(bit32.rshift(W0, 16), 15)
		buffer.writeu32(Vector, Out + 16, D4 + bit32.band(Q, bit32.arshift(D4, 31)))
		local D5 = X - bit32.band(bit32.rshift(W0, 20), 15)
		buffer.writeu32(Vector, Out + 20, D5 + bit32.band(Q, bit32.arshift(D5, 31)))
		local D6 = X - bit32.band(bit32.rshift(W0, 24), 15)
		buffer.writeu32(Vector, Out + 24, D6 + bit32.band(Q, bit32.arshift(D6, 31)))
		local D7 = X - bit32.rshift(W0, 28)
		buffer.writeu32(Vector, Out + 28, D7 + bit32.band(Q, bit32.arshift(D7, 31)))
	end
end

local function EncodeCentered13(Vector: buffer, VectorOffset: number, Coefficients: number, X: number, Output: buffer, OutputOffset: number)
	for Group = 0, Coefficients / 32 - 1 do
		local In = VectorOffset + Group * 128
		local Out = OutputOffset + Group * 52
		local D0 = X - buffer.readu32(Vector, In)
		local C0 = D0 + bit32.band(Q, bit32.arshift(D0, 31))
		local D1 = X - buffer.readu32(Vector, In + 4)
		local C1 = D1 + bit32.band(Q, bit32.arshift(D1, 31))
		local D2 = X - buffer.readu32(Vector, In + 8)
		local C2 = D2 + bit32.band(Q, bit32.arshift(D2, 31))
		buffer.writeu32(Output, Out, bit32.bor(C0, bit32.lshift(C1, 13), bit32.lshift(C2, 26)))
		local D3 = X - buffer.readu32(Vector, In + 12)
		local C3 = D3 + bit32.band(Q, bit32.arshift(D3, 31))
		local D4 = X - buffer.readu32(Vector, In + 16)
		local C4 = D4 + bit32.band(Q, bit32.arshift(D4, 31))
		buffer.writeu32(Output, Out + 4, bit32.bor(bit32.rshift(C2, 6), bit32.lshift(C3, 7), bit32.lshift(C4, 20)))
		local D5 = X - buffer.readu32(Vector, In + 20)
		local C5 = D5 + bit32.band(Q, bit32.arshift(D5, 31))
		local D6 = X - buffer.readu32(Vector, In + 24)
		local C6 = D6 + bit32.band(Q, bit32.arshift(D6, 31))
		local D7 = X - buffer.readu32(Vector, In + 28)
		local C7 = D7 + bit32.band(Q, bit32.arshift(D7, 31))
		buffer.writeu32(Output, Out + 8, bit32.bor(bit32.rshift(C4, 12), bit32.lshift(C5, 1), bit32.lshift(C6, 14), bit32.lshift(C7, 27)))
		local D8 = X - buffer.readu32(Vector, In + 32)
		local C8 = D8 + bit32.band(Q, bit32.arshift(D8, 31))
